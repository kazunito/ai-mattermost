MATTERMOST_URL=matter.210216.net
MATTERMOST_PORT=443
MATTERMOST_API_PATH=/api/v4
SCHEME=https
BOT_TOKEN=

# LLM provider: "gemini", "claude" or "deepseek"
LLM_PROVIDER=gemini

# Model for the selected provider.
#   Gemini:   gemini-1.5-flash (or gemini-2.0-flash-lite)
#   Claude:   claude-sonnet-4-6
#   DeepSeek: deepseek-chat
AI_MODEL=gemini-2.0-flash-lite

# Used by Claude and DeepSeek; ignored by Gemini.
AI_MAX_TOKENS=4096

AI_API_KEY=

# DeepSeek only: override the API endpoint if needed.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- AWS SNS alert handling (optional) ---
# Comma-separated list of Mattermost channel IDs that receive AWS SNS
# notifications via incoming webhooks. The bot will auto-reply to actionable
# alerts (Security Hub / CloudWatch Alarm / RDS Event / AWS Backup) with a
# structured Japanese response (summary / impact / checks / recommended
# actions). Leave empty to disable the feature.
AWS_ALERT_CHANNEL_IDS=

# Sliding-window rate limit for webhook-triggered auto-replies, applied
# per channel. Default: at most 5 replies per 600s (10 minutes).
# Set AWS_ALERT_RATE_LIMIT=0 to disable rate limiting.
# Do NOT put inline comments after the value — `KEY=5 # max` would be read
# as the literal string "5 # max" and crash on startup.
AWS_ALERT_RATE_LIMIT=5
AWS_ALERT_RATE_WINDOW_SECONDS=600
